{
  "schemaVersion": "1.0",
  "productVersion": "0.16.0",
  "targets": [
    {
      "id": "guard-linux-amd64",
      "runner": "ubuntu-24.04",
      "os": "linux",
      "arch": "x86_64",
      "required": true,
      "ciSigningMode": "none-linux-integrity",
      "requiredChecks": [
        "rustFormat",
        "guardUnitTests",
        "guardIntegrationTest",
        "clippy",
        "releaseBuild",
        "packageManifestVerified",
        "artifactHashesVerified",
        "authenticatedIpcV4",
        "runtimePolicyEnforced",
        "releasePackageBuilt",
        "linuxProductionGate",
        "guardRelease0139",
        "neverGuardRelease0140"
      ]
    },
    {
      "id": "guard-windows-amd64",
      "runner": "windows-2022",
      "os": "windows",
      "arch": "x86_64",
      "required": true,
      "ciSigningMode": "unsigned-development-ci",
      "requiredChecks": [
        "rustFormat",
        "guardUnitTests",
        "guardIntegrationTest",
        "clippy",
        "releaseBuild",
        "packageManifestVerified",
        "artifactHashesVerified",
        "authenticatedIpcV4",
        "runtimePolicyEnforced",
        "releasePackageBuilt",
        "windowsProductionGate",
        "guardRelease0139",
        "neverGuardRelease0140"
      ]
    },
    {
      "id": "guard-macos-universal",
      "runner": "macos-14",
      "os": "macos",
      "arch": "universal",
      "required": true,
      "ciSigningMode": "adhoc-ci",
      "requiredChecks": [
        "rustFormat",
        "guardUnitTests",
        "guardIntegrationTest",
        "clippy",
        "releaseBuild",
        "packageManifestVerified",
        "artifactHashesVerified",
        "authenticatedIpcV4",
        "runtimePolicyEnforced",
        "releasePackageBuilt",
        "macosProductionGate",
        "guardRelease0139",
        "neverGuardRelease0140"
      ]
    }
  ]
}
