{
  "schemaVersion": 1,
  "id": "launcher_quilt_bridge",
  "version": "${version}",
  "name": "Launcher Quilt Server Bridge",
  "description": "Server-only Launcher ServerBridge adapter for Quilt Loader.",
  "environment": "server",
  "entrypoints": {"main": ["ru.launcher.bridge.quilt.LauncherQuiltBridge"]},
  "mixins": ["launcher.quilt.mixins.json"],
  "depends": {
    "quilt_loader": ">=0.26.0",
    "minecraft": "~1.21.1",
    "fabric-api": "*",
    "java": ">=21"
  },
  "custom": {"launcher": {"platform": "quilt", "serverOnly": true, "clientModRequired": false, "universalAdapter": true}}
}
