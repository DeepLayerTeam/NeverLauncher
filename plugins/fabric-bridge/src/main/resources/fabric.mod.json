{
  "schemaVersion": 1,
  "id": "launcher_fabric_bridge",
  "version": "${version}",
  "name": "Launcher Fabric Server Bridge",
  "description": "Server-only Launcher ServerBridge integration for Fabric 1.21.1.",
  "authors": ["Launcher Team"],
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "main": [
      "ru.launcher.bridge.fabric.LauncherFabricBridge"
    ]
  },
  "mixins": [
    "launcher.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.116.0+1.21.1",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "custom": {
    "launcher": {
      "serverBridgeProtocol": 2,
      "serverType": "fabric",
      "clientModRequired": false
    }
  }
}
