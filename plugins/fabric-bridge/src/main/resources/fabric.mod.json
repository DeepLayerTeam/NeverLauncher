{
  "schemaVersion": 1,
  "id": "neverlauncher_fabric_bridge",
  "version": "${version}",
  "name": "NeverLauncher Fabric Server Bridge",
  "description": "Server-only NeverLauncher ServerBridge integration for Fabric 1.21.1.",
  "authors": ["NeverLauncher Team"],
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "main": [
      "ru.neverlauncher.bridge.fabric.NeverLauncherFabricBridge"
    ]
  },
  "mixins": [
    "neverlauncher.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": ">=0.116.0+1.21.1",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "custom": {
    "neverlauncher": {
      "serverBridgeProtocol": 2,
      "serverType": "fabric",
      "clientModRequired": false
    }
  }
}
