[Unit]
Description=Launcher API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=launcher
Group=launcher
WorkingDirectory=/opt/launcher
EnvironmentFile=/opt/launcher/.env
ExecStart=/opt/launcher/bin/launcher-api
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/launcher /var/log/launcher /opt/launcher/data
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
