# NeverLauncher 0.51.3. Copy to /etc/launcher/ha-0513.env on BOTH HAProxy hosts.
# chmod 600. Only HA_LB_LOCAL_IP/HA_LB_PEER_IP/HA_PRIORITY differ.
# TLS certs of each backend MUST match the stable public/dependency DNS names.
# No secrets here. HA_REDIS_HEALTH_PASSWORD_FILE is an external mode 0600 file.
HA_INTERFACE=eth1
HA_PUBLIC_VIP=10.20.0.100
HA_DEPENDENCY_VIP=10.20.0.101
HA_LB_LOCAL_IP=10.20.0.11
HA_LB_PEER_IP=10.20.0.12
HA_VIP_PREFIX=24
HA_PRIORITY=150
HA_VRRP_ID=51
HA_PUBLIC_NAME=launcher.example
HA_REDIS_NAME=redis-ha.internal
HA_S3_NAME=s3-ha.internal
HA_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Two separately hosted production ingress instances. The API /ready
# endpoint (not Nginx /health) is the successful health criterion.
HA_INGRESS=api-a@10.30.0.11:443,api-b@10.30.0.12:443
# Two independently durable Patroni PostgreSQL members; /primary returns
# HTTP 200 only on the current writer with valid DCS lock.
HA_POSTGRES=pg-a@10.40.0.11:5432,pg-b@10.40.0.12:5432,pg-c@10.40.0.13:5432
HA_PATRONI_PORT=8008
# Redis TLS replicas with quorum-backed Sentinel / cluster failover already
# configured. Read-only health-check user must be allowed INFO replication.
HA_REDIS=redis-a@10.50.0.11:6380,redis-b@10.50.0.12:6380,redis-c@10.50.0.13:6380
HA_REDIS_LISTEN_PORT=6380
HA_REDIS_HEALTH_USER=healthcheck
HA_REDIS_HEALTH_PASSWORD_FILE=/etc/launcher/secrets/redis-ha-health-password
# Gateways MUST serve the same distributed, replicated object namespace.
# This switch is an operator attestation, NOT automatic data verification.
HA_S3=s3-a@10.60.0.11:443,s3-b@10.60.0.12:443
HA_S3_HEALTH_PATH=/minio/health/cluster
HA_S3_SHARED_BACKEND_CONFIRMED=yes
# Scoped probe-only S3 key, restricted to launcher-ha-probe-0513/*.
# Different from the application's full S3 credentials.
HA_S3_BUCKET=launcher
HA_S3_REGION=eu-west-1
HA_S3_ACCESS_KEY_FILE=/etc/launcher/secrets/s3-ha-probe-access-key
HA_S3_SECRET_KEY_FILE=/etc/launcher/secrets/s3-ha-probe-secret-key
