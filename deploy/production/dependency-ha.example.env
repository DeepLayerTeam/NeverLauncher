# Launcher 0.51.3. Скопируйте в /etc/launcher/ha-0513.env на ОБА хоста HAProxy.
# Установите права chmod 600. Отличаются только HA_LB_LOCAL_IP/HA_LB_PEER_IP/HA_PRIORITY.
# TLS-сертификаты каждого Backend ОБЯЗАТЕЛЬНО должны соответствовать постоянным публичным DNS-именам и именам зависимостей.
# Секретов в этом файле нет. HA_REDIS_HEALTH_PASSWORD_FILE указывает на внешний файл с правами 0600.
HA_INTERFACE=eth1
HA_PUBLIC_VIP=10.20.0.100
HA_DEPENDENCY_VIP=10.20.0.101
HA_LB_LOCAL_IP=10.20.0.11
HA_LB_PEER_IP=10.20.0.12
HA_VIP_PREFIX=24
HA_PRIORITY=150
HA_VRRP_ID=51
HA_PUBLIC_NAME=launcher.example
HA_REDIS_NAME=redis-ha.internal
HA_S3_NAME=s3-ha.internal
HA_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Два отдельно размещённых промышленных входных узла. Критерий работоспособности —
# endpoint API /ready, а не Nginx /health.
HA_INGRESS=api-a@10.30.0.11:443,api-b@10.30.0.12:443
# Два независимых отказоустойчивых узла Patroni PostgreSQL; /primary возвращает
# HTTP 200 только на текущем узле записи с действующей блокировкой DCS.
HA_POSTGRES=pg-a@10.40.0.11:5432,pg-b@10.40.0.12:5432,pg-c@10.40.0.13:5432
HA_PATRONI_PORT=8008
# Реплики Redis по TLS с уже настроенным переключением Sentinel/кластера по кворуму.
# Пользователю проверки состояния только для чтения необходим доступ к INFO replication.
HA_REDIS=redis-a@10.50.0.11:6380,redis-b@10.50.0.12:6380,redis-c@10.50.0.13:6380
HA_REDIS_LISTEN_PORT=6380
HA_REDIS_HEALTH_USER=healthcheck
HA_REDIS_HEALTH_PASSWORD_FILE=/etc/launcher/secrets/redis-ha-health-password
# Шлюзы ОБЯЗАТЕЛЬНО должны обслуживать одно распределённое реплицируемое пространство объектов.
# Этот переключатель — подтверждение оператора, а НЕ автоматическая проверка данных.
HA_S3=s3-a@10.60.0.11:443,s3-b@10.60.0.12:443
HA_S3_HEALTH_PATH=/minio/health/cluster
HA_S3_SHARED_BACKEND_CONFIRMED=yes
# Ограниченный ключ S3 только для проверок, с доступом к launcher-ha-probe-0513/*.
# Отличается от полных учётных данных приложения для S3.
HA_S3_BUCKET=launcher
HA_S3_REGION=eu-west-1
HA_S3_ACCESS_KEY_FILE=/etc/launcher/secrets/s3-ha-probe-access-key
HA_S3_SECRET_KEY_FILE=/etc/launcher/secrets/s3-ha-probe-secret-key
