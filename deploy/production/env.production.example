POSTGRES_DB=neverlauncher
POSTGRES_USER=neverlauncher
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# Используйте URL-безопасные символы либо hex, так как значение встраивается в NEVERLAUNCHER_REDIS_URL.
# Redis is optional in Standard (only needed with network-ha overlay).
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_HEX_PASSWORD

# Default compose: PostgreSQL + SQLite coordinator, one Backend. NOT SQLite-only.
# HA overlay: PostgreSQL + Redis + S3; see docs/releases/0.32.13-production-deployment.md.
NEVERLAUNCHER_DEPLOYMENT_MODE=standard
NEVERLAUNCHER_ENV=production
NEVERLAUNCHER_PUBLIC_URL=https://launcher.example.com
# Exact public HTTPS texture hosts, comma separated; blank permits any public HTTPS DNS hostname.
NEVERLAUNCHER_TEXTURE_FETCH_HOST_ALLOWLIST=
NEVERLAUNCHER_HTTP_PORT=80
NEVERLAUNCHER_IMAGE_TAG=0.33.2
NEVERLAUNCHER_REPOSITORY_DRIVER=postgres
NEVERLAUNCHER_SQL_DRIVER=pgx
NEVERLAUNCHER_DATABASE_AUTO_MIGRATE=true
NEVERLAUNCHER_BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM_ONE_TIME_TOKEN
NEVERLAUNCHER_MANIFEST_SIGNING_PRIVATE_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Доверенные открытые ключи Ed25519 для проверки CI-свидетельств выполнения. Оставьте пустым, если все проекты используют только проверку целостности.
NEVERLAUNCHER_RUNTIME_VALIDATION_KEYS_JSON=
NEVERLAUNCHER_SERVERBRIDGE_CONTROL_SIGNING_PRIVATE_KEY=CHANGE_ME_TO_DEDICATED_64_HEX_ED25519_SEED
# При ротации без простоя новый seed выше, предыдущий ниже; удалите прежний после перехода всех мостов на новый ключ.
NEVERLAUNCHER_SERVERBRIDGE_CONTROL_PREVIOUS_SIGNING_PRIVATE_KEY=
# Управляющий сервис HA: каждая реплика API имеет устойчивый уникальный ID; Redis — временный ограничитель, PostgreSQL — постоянный источник истины.
NEVERLAUNCHER_SERVERBRIDGE_HA_REQUIRED=false
NEVERLAUNCHER_REPLICA_ID=api-1
NEVERLAUNCHER_AUTH_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Ротация JWS/JWT-ключей токенов доступа в системе управления сеансами 2.0.
# Сохраняйте прежние ключи в JSON-наборе до истечения всех подписанных ими токенов.
NEVERLAUNCHER_AUTH_TOKEN_ISSUER=
NEVERLAUNCHER_AUTH_TOKEN_AUDIENCE=neverlauncher-api
NEVERLAUNCHER_AUTH_TOKEN_ACTIVE_KID=primary
NEVERLAUNCHER_AUTH_TOKEN_KEYS_JSON=

# Проверяемая сервером политика выпуска NeverGuard 0.14. При отсутствии или ошибке формата производственный запуск запрещён.
# Для NeverGuard 0.14+ используйте объединённую политику schemaVersion=2.0 из итоговых подписанных фрагментов пакетов
# Windows/Linux/macOS. Создавайте её через scripts/release/merge-guard-release-policy.py после подписания поставщиком.
NEVERLAUNCHER_GUARD_RELEASE_ALLOWLIST_JSON=
NEVERLAUNCHER_BRIDGE_RELEASE_ALLOWLIST_JSON=

# Необязательная SQL-федерация аутентификации. Предпочитайте dsnEnv в JSON провайдера, чтобы пароли БД не хранились в файле сопоставления.
NEVERLAUNCHER_AUTH_SQL_PROVIDERS_JSON=
# NEVERLAUNCHER_AUTH_SQL_PROVIDERS_FILE=/etc/neverlauncher/auth-sql-providers.json
# WEBSITE_AUTH_DATABASE_DSN=postgres://readonly:CHANGE_ME@db.example.com:5432/site?sslmode=verify-full
# Необязательная HTTP-федерация аутентификации. Секрет HMAC передаётся отдельно от JSON провайдера.
NEVERLAUNCHER_AUTH_HTTP_PROVIDERS_JSON=
# NEVERLAUNCHER_AUTH_HTTP_PROVIDERS_FILE=/etc/neverlauncher/auth-http-providers.json
WEBSITE_AUTH_HTTP_HMAC_SECRET=
# Необязательная федерация OIDC. Клиентский секрет храните отдельно от JSON провайдера.
NEVERLAUNCHER_AUTH_OIDC_PROVIDERS_JSON=
# NEVERLAUNCHER_AUTH_OIDC_PROVIDERS_FILE=/etc/neverlauncher/auth-oidc-providers.json
OIDC_CLIENT_SECRET=
# Необязательная федерация удостоверений Microsoft. Секрет приложения храните отдельно от JSON провайдера.
NEVERLAUNCHER_AUTH_MICROSOFT_PROVIDERS_JSON=
# NEVERLAUNCHER_AUTH_MICROSOFT_PROVIDERS_FILE=/etc/neverlauncher/auth-microsoft-providers.json
MICROSOFT_CLIENT_SECRET=
NEVERLAUNCHER_WEBAUTHN_RP_ID=example.com
NEVERLAUNCHER_WEBAUTHN_RP_NAME=NeverLauncher
NEVERLAUNCHER_WEBAUTHN_ORIGINS=https://launcher.example.com
NEVERLAUNCHER_CORS_ALLOWED_ORIGINS=https://launcher.example.com
NEVERLAUNCHER_BACKUP_ROOT=/var/lib/neverlauncher/backups
NEVERLAUNCHER_EXTENSION_ROOT=/var/lib/neverlauncher/extensions
NEVERLAUNCHER_EXTENSION_BACKUP_RETENTION=10
NEVERLAUNCHER_EXTENSION_HOST_ENABLED=true
NEVERLAUNCHER_EXTENSION_HOST_LISTEN=127.0.0.1:0
NEVERLAUNCHER_EXTENSION_HOST_STARTUP_TIMEOUT_SECONDS=10
NEVERLAUNCHER_EXTENSION_HOST_HEARTBEAT_TIMEOUT_SECONDS=30
NEVERLAUNCHER_EXTENSION_HOST_STOP_TIMEOUT_SECONDS=5
NEVERLAUNCHER_EXTENSION_HOST_CAPABILITY_TIMEOUT_SECONDS=3
NEVERLAUNCHER_EXTENSION_HOST_MAX_MEMORY_MB=512
NEVERLAUNCHER_EXTENSION_HOST_MAX_PROCESSES=8
NEVERLAUNCHER_EXTENSION_HOST_MAX_LOG_BYTES=4194304
NEVERLAUNCHER_EXTENSION_HOST_MAX_LOG_ENTRIES=1000
NEVERLAUNCHER_EXTENSION_HOST_MAX_PROTOCOL_BODY_BYTES=1048576
NEVERLAUNCHER_EXTENSION_HOST_MAX_STORAGE_READ_BYTES=1048576
NEVERLAUNCHER_EXTENSION_HOST_CRASH_LIMIT=5
NEVERLAUNCHER_EXTENSION_HOST_CRASH_WINDOW_SECONDS=600
NEVERLAUNCHER_EXTENSION_HOST_RESTART_BACKOFF_MS=1000
NEVERLAUNCHER_EXTENSION_EVENTS_ENABLED=true
NEVERLAUNCHER_EXTENSION_EVENTS_WORKER_INTERVAL_MS=250
NEVERLAUNCHER_EXTENSION_EVENTS_LEASE_SECONDS=30
NEVERLAUNCHER_EXTENSION_EVENTS_HOOK_TIMEOUT_MS=2000
NEVERLAUNCHER_EXTENSION_EVENTS_MAX_ATTEMPTS=8
NEVERLAUNCHER_EXTENSION_EVENTS_BASE_RETRY_MS=1000
NEVERLAUNCHER_EXTENSION_EVENTS_MAX_RETRY_SECONDS=300
NEVERLAUNCHER_EXTENSION_EVENTS_BATCH_SIZE=32

NEVERLAUNCHER_RATE_LIMIT_GLOBAL_PER_MINUTE=1200
NEVERLAUNCHER_RATE_LIMIT_AUTH_PER_MINUTE=20
NEVERLAUNCHER_RATE_LIMIT_SERVERBRIDGE_PER_MINUTE=6000
# Защита разрешений NeverExtensions 0.20.7. Нужна для брокера зашифрованных
# секретов. 32 случайных байта в hex или base64. Пример: openssl rand -hex 32
NEVERLAUNCHER_EXTENSION_SECRETS_KEY=
NEVERLAUNCHER_EXTENSION_HTTP_MAX_REQUEST_BYTES=262144
NEVERLAUNCHER_EXTENSION_HTTP_MAX_RESPONSE_BYTES=1048576
NEVERLAUNCHER_EXTENSION_HTTP_TIMEOUT_SECONDS=10

# Required only for Network/HA overlay (use real values and unique replica IDs).
NEVERLAUNCHER_STORAGE_S3_ENDPOINT=
NEVERLAUNCHER_STORAGE_S3_BUCKET=
NEVERLAUNCHER_STORAGE_S3_REGION=
NEVERLAUNCHER_STORAGE_S3_ACCESS_KEY=
NEVERLAUNCHER_STORAGE_S3_SECRET_KEY=
NEVERLAUNCHER_STORAGE_S3_PATH_STYLE=true
