POSTGRES_DB=launcher
POSTGRES_USER=launcher
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# Используйте URL-безопасные символы либо hex, так как значение встраивается в LAUNCHER_REDIS_URL.
# Redis is optional in Standard (only needed with network-ha overlay).
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_HEX_PASSWORD

# Default compose: PostgreSQL + SQLite coordinator, one Backend. NOT SQLite-only.
# HA overlay: PostgreSQL + Redis + S3; see docs/releases/0.32.13-production-deployment.md.
LAUNCHER_DEPLOYMENT_MODE=standard
LAUNCHER_ENV=production
LAUNCHER_PUBLIC_URL=https://launcher.example.com
# Exact public HTTPS texture hosts, comma separated; blank permits any public HTTPS DNS hostname.
LAUNCHER_TEXTURE_FETCH_HOST_ALLOWLIST=
LAUNCHER_HTTP_PORT=80
LAUNCHER_IMAGE_TAG=0.43.0
LAUNCHER_REPOSITORY_DRIVER=postgres
LAUNCHER_SQL_DRIVER=pgx
LAUNCHER_DATABASE_AUTO_MIGRATE=true
LAUNCHER_BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM_ONE_TIME_TOKEN
LAUNCHER_MANIFEST_SIGNING_PRIVATE_KEY=CHANGE_ME_TO_64_HEX_CHARACTERS
# Доверенные открытые ключи Ed25519 для проверки CI-свидетельств выполнения. Оставьте пустым, если все проекты используют только проверку целостности.
LAUNCHER_RUNTIME_VALIDATION_KEYS_JSON=
LAUNCHER_SERVERBRIDGE_CONTROL_SIGNING_PRIVATE_KEY=CHANGE_ME_TO_DEDICATED_64_HEX_ED25519_SEED
# При ротации без простоя новый seed выше, предыдущий ниже; удалите прежний после перехода всех мостов на новый ключ.
LAUNCHER_SERVERBRIDGE_CONTROL_PREVIOUS_SIGNING_PRIVATE_KEY=
# Управляющий сервис HA: каждая реплика API имеет устойчивый уникальный ID; Redis — временный ограничитель, PostgreSQL — постоянный источник истины.
LAUNCHER_SERVERBRIDGE_HA_REQUIRED=false
LAUNCHER_REPLICA_ID=api-1
LAUNCHER_AUTH_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Ротация JWS/JWT-ключей токенов доступа в системе управления сеансами 2.0.
# Сохраняйте прежние ключи в JSON-наборе до истечения всех подписанных ими токенов.
LAUNCHER_AUTH_TOKEN_ISSUER=
LAUNCHER_AUTH_TOKEN_AUDIENCE=launcher-api
LAUNCHER_AUTH_TOKEN_ACTIVE_KID=primary
LAUNCHER_AUTH_TOKEN_KEYS_JSON=

# Проверяемая сервером политика выпуска Guard 0.14. При отсутствии или ошибке формата производственный запуск запрещён.
# Для Guard 0.14+ используйте объединённую политику schemaVersion=2.0 из итоговых подписанных фрагментов пакетов
# Windows/Linux/macOS. Создавайте её через scripts/release/merge-guard-release-policy.py после подписания поставщиком.
LAUNCHER_GUARD_RELEASE_ALLOWLIST_JSON=
LAUNCHER_BRIDGE_RELEASE_ALLOWLIST_JSON=

# Необязательная SQL-федерация аутентификации. Предпочитайте dsnEnv в JSON провайдера, чтобы пароли БД не хранились в файле сопоставления.
# Live FileAuthSystem source (read-only); use either JSON or FILE.
LAUNCHER_AUTH_FILE_PROVIDERS_JSON=
# LAUNCHER_AUTH_FILE_PROVIDERS_FILE=/etc/launcher/auth-file-providers.json
LAUNCHER_AUTH_SQL_PROVIDERS_JSON=
# LAUNCHER_AUTH_SQL_PROVIDERS_FILE=/etc/launcher/auth-sql-providers.json
# WEBSITE_AUTH_DATABASE_DSN=postgres://readonly:CHANGE_ME@db.example.com:5432/site?sslmode=verify-full
# Необязательная HTTP-федерация аутентификации. Секрет HMAC передаётся отдельно от JSON провайдера.
LAUNCHER_AUTH_HTTP_PROVIDERS_JSON=
# LAUNCHER_AUTH_HTTP_PROVIDERS_FILE=/etc/launcher/auth-http-providers.json
WEBSITE_AUTH_HTTP_HMAC_SECRET=
# Необязательная федерация OIDC. Клиентский секрет храните отдельно от JSON провайдера.
LAUNCHER_AUTH_OIDC_PROVIDERS_JSON=
# LAUNCHER_AUTH_OIDC_PROVIDERS_FILE=/etc/launcher/auth-oidc-providers.json
OIDC_CLIENT_SECRET=
# Необязательная федерация удостоверений Microsoft. Секрет приложения храните отдельно от JSON провайдера.
LAUNCHER_AUTH_MICROSOFT_PROVIDERS_JSON=
# LAUNCHER_AUTH_MICROSOFT_PROVIDERS_FILE=/etc/launcher/auth-microsoft-providers.json
MICROSOFT_CLIENT_SECRET=
LAUNCHER_WEBAUTHN_RP_ID=example.com
LAUNCHER_WEBAUTHN_RP_NAME=Launcher
LAUNCHER_WEBAUTHN_ORIGINS=https://launcher.example.com
LAUNCHER_CORS_ALLOWED_ORIGINS=https://launcher.example.com
LAUNCHER_BACKUP_ROOT=/var/lib/launcher/backups
LAUNCHER_EXTENSION_ROOT=/var/lib/launcher/extensions
LAUNCHER_EXTENSION_BACKUP_RETENTION=10
LAUNCHER_EXTENSION_HOST_ENABLED=true
LAUNCHER_EXTENSION_HOST_LISTEN=127.0.0.1:0
LAUNCHER_EXTENSION_HOST_STARTUP_TIMEOUT_SECONDS=10
LAUNCHER_EXTENSION_HOST_HEARTBEAT_TIMEOUT_SECONDS=30
LAUNCHER_EXTENSION_HOST_STOP_TIMEOUT_SECONDS=5
LAUNCHER_EXTENSION_HOST_CAPABILITY_TIMEOUT_SECONDS=3
LAUNCHER_EXTENSION_HOST_MAX_MEMORY_MB=512
LAUNCHER_EXTENSION_HOST_MAX_PROCESSES=8
LAUNCHER_EXTENSION_HOST_MAX_LOG_BYTES=4194304
LAUNCHER_EXTENSION_HOST_MAX_LOG_ENTRIES=1000
LAUNCHER_EXTENSION_HOST_MAX_PROTOCOL_BODY_BYTES=1048576
LAUNCHER_EXTENSION_HOST_MAX_STORAGE_READ_BYTES=1048576
LAUNCHER_EXTENSION_HOST_CRASH_LIMIT=5
LAUNCHER_EXTENSION_HOST_CRASH_WINDOW_SECONDS=600
LAUNCHER_EXTENSION_HOST_RESTART_BACKOFF_MS=1000
LAUNCHER_EXTENSION_EVENTS_ENABLED=true
LAUNCHER_EXTENSION_EVENTS_WORKER_INTERVAL_MS=250
LAUNCHER_EXTENSION_EVENTS_LEASE_SECONDS=30
LAUNCHER_EXTENSION_EVENTS_HOOK_TIMEOUT_MS=2000
LAUNCHER_EXTENSION_EVENTS_MAX_ATTEMPTS=8
LAUNCHER_EXTENSION_EVENTS_BASE_RETRY_MS=1000
LAUNCHER_EXTENSION_EVENTS_MAX_RETRY_SECONDS=300
LAUNCHER_EXTENSION_EVENTS_BATCH_SIZE=32

LAUNCHER_RATE_LIMIT_GLOBAL_PER_MINUTE=1200
LAUNCHER_RATE_LIMIT_AUTH_PER_MINUTE=20
LAUNCHER_RATE_LIMIT_SERVERBRIDGE_PER_MINUTE=6000
# Защита разрешений Extensions 0.20.7. Нужна для брокера зашифрованных
# секретов. 32 случайных байта в hex или base64. Пример: openssl rand -hex 32
LAUNCHER_EXTENSION_SECRETS_KEY=
LAUNCHER_EXTENSION_HTTP_MAX_REQUEST_BYTES=262144
LAUNCHER_EXTENSION_HTTP_MAX_RESPONSE_BYTES=1048576
LAUNCHER_EXTENSION_HTTP_TIMEOUT_SECONDS=10

# Required only for Network/HA overlay (use real values and unique replica IDs).
LAUNCHER_STORAGE_S3_ENDPOINT=
LAUNCHER_STORAGE_S3_BUCKET=
LAUNCHER_STORAGE_S3_REGION=
LAUNCHER_STORAGE_S3_ACCESS_KEY=
LAUNCHER_STORAGE_S3_SECRET_KEY=
LAUNCHER_STORAGE_S3_PATH_STYLE=true
