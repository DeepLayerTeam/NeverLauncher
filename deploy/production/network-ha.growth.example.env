# Apply on top of the full, secure Launcher production configuration.
# This file alone is NOT a bootable or complete set of credentials/policies.
LAUNCHER_DEPLOYMENT_MODE=network-ha
LAUNCHER_REPOSITORY_DRIVER=postgres
LAUNCHER_SQL_DRIVER=pgx
LAUNCHER_DATABASE_AUTO_MIGRATE=false
LAUNCHER_SERVERBRIDGE_HA_REQUIRED=true
# LAUNCHER_REDIS_URL=rediss://<user>:<secret>@redis.internal:6379/0
LAUNCHER_RATE_LIMIT_ENABLED=true
LAUNCHER_RATE_LIMIT_FAIL_CLOSED=true
LAUNCHER_STORAGE_DRIVER=s3
LAUNCHER_STORAGE_S3_PATH_STYLE=true
# LAUNCHER_STORAGE_S3_ENDPOINT=https://s3.internal
# LAUNCHER_STORAGE_S3_BUCKET=launcher
# LAUNCHER_STORAGE_S3_REGION=us-east-1
# LAUNCHER_STORAGE_S3_ACCESS_KEY=...
# LAUNCHER_STORAGE_S3_SECRET_KEY=...
# LAUNCHER_REPLICA_ID must differ for each running backend replica.
# LAUNCHER_SINGLE_NODE_COORDINATOR_SQLITE_PATH must be unset.
