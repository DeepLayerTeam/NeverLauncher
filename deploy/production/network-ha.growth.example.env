# Apply on top of the full, secure NeverLauncher production configuration.
# This file alone is NOT a bootable or complete set of credentials/policies.
NEVERLAUNCHER_DEPLOYMENT_MODE=network-ha
NEVERLAUNCHER_REPOSITORY_DRIVER=postgres
NEVERLAUNCHER_SQL_DRIVER=pgx
NEVERLAUNCHER_DATABASE_AUTO_MIGRATE=false
NEVERLAUNCHER_SERVERBRIDGE_HA_REQUIRED=true
# NEVERLAUNCHER_REDIS_URL=rediss://<user>:<secret>@redis.internal:6379/0
NEVERLAUNCHER_RATE_LIMIT_ENABLED=true
NEVERLAUNCHER_RATE_LIMIT_FAIL_CLOSED=true
NEVERLAUNCHER_STORAGE_DRIVER=s3
NEVERLAUNCHER_STORAGE_S3_PATH_STYLE=true
# NEVERLAUNCHER_STORAGE_S3_ENDPOINT=https://s3.internal
# NEVERLAUNCHER_STORAGE_S3_BUCKET=neverlauncher
# NEVERLAUNCHER_STORAGE_S3_REGION=us-east-1
# NEVERLAUNCHER_STORAGE_S3_ACCESS_KEY=...
# NEVERLAUNCHER_STORAGE_S3_SECRET_KEY=...
# NEVERLAUNCHER_REPLICA_ID must differ for each running backend replica.
# NEVERLAUNCHER_SINGLE_NODE_COORDINATOR_SQLITE_PATH must be unset.
