# 0.51.2 multi-host. Copy to deploy/production/.env separately ON EACH HOST.
# chmod 600 .env; supply real cryptographically random secrets/real signed policy.
# Only LAUNCHER_NODE_ID and LAUNCHER_INGRESS_BIND_IP differ between the two
# hosts. Both must use exactly the same release digest and shared services.
LAUNCHER_COMPOSE_PROJECT=launcher
LAUNCHER_NODE_ID=node-a
LAUNCHER_INGRESS_BIND_IP=10.0.0.10

# Images published and verified by release pipeline; pin to actual digests.
LAUNCHER_API_IMAGE=registry.example/launcher/api@sha256:REPLACE_WITH_REAL_SHA256
LAUNCHER_ADMIN_IMAGE=registry.example/launcher/admin@sha256:REPLACE_WITH_REAL_SHA256
LAUNCHER_NGINX_IMAGE=docker.io/library/nginx@sha256:REPLACE_WITH_REAL_SHA256
LAUNCHER_INIT_IMAGE=docker.io/library/alpine@sha256:REPLACE_WITH_REAL_SHA256

# Shared EXTERNAL services. No local postgres/redis/S3 can be used.
# URL-encode credentials in the DSN. sslrootcert may reference a trusted
# cert shipped inside the backend image.
LAUNCHER_DATABASE_DSN=postgres://launcher:REPLACE@postgres.internal:5432/launcher?sslmode=verify-full
LAUNCHER_REDIS_URL=rediss://:REPLACE@redis.internal:6379/0
LAUNCHER_STORAGE_S3_ENDPOINT=https://s3.internal
LAUNCHER_STORAGE_S3_BUCKET=launcher
LAUNCHER_STORAGE_S3_REGION=eu-west-1
LAUNCHER_STORAGE_S3_ACCESS_KEY=REPLACE
LAUNCHER_STORAGE_S3_SECRET_KEY=REPLACE
LAUNCHER_STORAGE_S3_PATH_STYLE=true

# Public origin belongs to the EXTERNAL load balancer, not to either host.
LAUNCHER_PUBLIC_URL=https://launcher.example
LAUNCHER_TLS_CERT_PATH=/etc/launcher/tls/fullchain.pem
LAUNCHER_TLS_KEY_PATH=/etc/launcher/tls/privkey.pem

# Shared identity/trust configuration; use the SAME values on each host.
LAUNCHER_AUTH_TOKEN_SECRET=REPLACE
LAUNCHER_MANIFEST_SIGNING_PRIVATE_KEY=REPLACE
LAUNCHER_RUNTIME_VALIDATION_KEYS_JSON=
LAUNCHER_GUARD_RELEASE_ALLOWLIST_JSON=REPLACE
LAUNCHER_BRIDGE_RELEASE_ALLOWLIST_JSON=REPLACE
LAUNCHER_WEBAUTHN_RP_ID=launcher.example
LAUNCHER_WEBAUTHN_ORIGINS=https://launcher.example
LAUNCHER_CORS_ALLOWED_ORIGINS=https://launcher.example
LAUNCHER_EXTENSION_SECRETS_KEY=REPLACE
# Add the provider-specific configuration already used by the project.
