# Image is built on the OPERATOR'S trusted build system and pushed to a private
# registry. The attestation host only executes its immutable @sha256 digest.
FROM golang:1.27.3 AS cli
WORKDIR /build
COPY cli/ ./cli/
RUN cd cli && CGO_ENABLED=0 go build -trimpath -o /build/launcher ./cmd/launcher

FROM rust:1.91 AS runtime
WORKDIR /build
COPY runtime/runtime/ ./runtime/runtime/
RUN cargo build --release --manifest-path runtime/runtime/Cargo.toml --bin runtime --bin guard

FROM eclipse-temurin:21-jre-noble
ARG SOURCE_SHA
ARG BUILD_SHA
LABEL org.opencontainers.image.revision="${SOURCE_SHA}" \
    io.launcher.validation.build-sha256="${BUILD_SHA}"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates xvfb xauth libgl1-mesa-dri libglx-mesa0 libegl1 libvulkan1 \
    libx11-6 libxext6 libxrender1 libxtst6 libxi6 libxrandr2 libxcursor1 \
    libxinerama1 libasound2t64 x11-utils mesa-utils scrot imagemagick \
    tesseract-ocr tesseract-ocr-eng xdotool unzip curl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=cli /build/launcher /opt/launcher
COPY --from=runtime /build/runtime/runtime/target/release/runtime /opt/runtime
COPY --from=runtime /build/runtime/runtime/target/release/guard /opt/guard
COPY e2e/scripts/run-staged-package.py /opt/staged/run-staged-package.py
COPY e2e/scripts/staged_readiness.py /opt/staged/staged_readiness.py
COPY e2e/scripts/runtime_capabilities.py /opt/staged/runtime_capabilities.py
COPY e2e/scripts/native_window.py /opt/staged/native_window.py
COPY e2e/scripts/process_group.py /opt/staged/process_group.py
COPY e2e/scripts/staged_auth.py /opt/staged/staged_auth.py
COPY e2e/scripts/staged_matching.py /opt/staged/staged_matching.py
COPY e2e/scripts/staged_lifecycle.py /opt/staged/staged_lifecycle.py
ENV JAVA_HOME_21_X64=/opt/java/openjdk \
    XDG_CACHE_HOME=/tmp/nl-cache HOME=/tmp \
    LIBGL_ALWAYS_SOFTWARE=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/usr/bin/xvfb-run", "-a", "-s", "-screen 0 1280x720x24 +extension GLX +render -noreset", "/usr/bin/python3", "/opt/staged/run-staged-package.py"]
