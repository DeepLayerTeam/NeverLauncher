{
  "schemaVersion":"2.0",
  "id":"org.example.java-ui",
  "name":"Пример Java для Admin, Desktop и CLI",
  "version":"0.1.0",
  "publisher":"NeverLauncher Examples",
  "api":"1.0",
  "targets":[
    {"kind":"backend","entrypoint":"backend/workspace.jar"},
    {"kind":"admin","entrypoint":"admin/index.html"},
    {"kind":"desktop","entrypoint":"desktop/index.html"},
    {"kind":"cli","entrypoint":"cli/workspace.jar"}
  ],
  "permissions":["ui:contribute","desktop:contribute","cli:contribute","storage:read","storage:write"],
  "admin":{"pages":[{"id":"main","title":"Управление Java"}],
    "navigation":[{"id":"main-nav","label":"Управление Java","pageId":"main"}],
    "actions":[{"id":"refresh","label":"Обновить через Java","pageId":"main","placement":"toolbar"}]},
  "desktop":{"pages":[{"id":"main","title":"Управление Java"}],
    "navigation":[{"id":"main-nav","label":"Управление Java","pageId":"main"}],
    "actions":[{"id":"refresh","label":"Обновить через Java","pageId":"main","placement":"toolbar"}]},
  "cli":{"namespace":"java-ui","commands":[{"name":"status","description":"Прочитать состояние выполнения Java-расширения"}]}
}
