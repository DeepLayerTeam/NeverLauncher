{
  "schemaVersion": "2.0",
  "id": "ru.example.launcher.cli-status",
  "name": "Пример проверки состояния через CLI",
  "version": "0.1.0",
  "publisher": "Launcher Examples",
  "api": "1.0",
  "targets": [
    {
      "kind": "cli",
      "entrypoint": "cli/bin/extension-cli"
    }
  ],
  "permissions": [
    "cli:contribute"
  ],
  "cli": {
    "namespace": "example",
    "commands": [
      {
        "name": "status",
        "description": "Показать состояние расширения",
        "usage": "nl x example status"
      }
    ]
  }
}
