{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neverlauncher.local/schemas/neverlauncher-extension-package.schema.json",
  "title": "NeverLauncher Пакет расширения Дескриптор",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "extensionId",
    "extensionVersion",
    "publisher",
    "api",
    "buildEpoch",
    "packageIdentity",
    "manifestSha256",
    "canonicalManifestSha256",
    "checksumsSha256",
    "sbomSha256",
    "payload"
  ],
  "properties": {
    "format": {
      "const": "NeverLauncher Extension Package"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "extensionVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "api": {
      "type": "string",
      "enum": [
        "1.0",
        "3.7"
      ],
      "description": "Расширение API v1. Новый 0.21+ публикация MUST использовать 1.0; 3.7 является read/run совместимость псевдоним для неизменяемый 0.20.x артефакты."
    },
    "buildEpoch": {
      "type": "integer",
      "minimum": 315532800
    },
    "packageIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalManifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checksumsSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sbomSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileCount",
        "totalBytes",
        "files"
      ],
      "properties": {
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536870912
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mode": {
                "enum": [
                  "0644",
                  "0755"
                ]
              }
            }
          }
        }
      }
    }
  }
}
