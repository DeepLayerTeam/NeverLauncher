{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launcher.local/schemas/launcher-desktop-extension-rpc.schema.json",
  "title": "Launcher Desktop Extension RPC v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "id", "method"],
      "properties": {
        "protocol": { "const": "extensions.desktop-rpc.v1" },
        "type": { "const": "rpc.request" },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "method": { "type": "string", "minLength": 1, "maxLength": 64 },
        "params": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "id"],
      "properties": {
        "protocol": { "const": "extensions.desktop-rpc.v1" },
        "type": { "const": "rpc.response" },
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "result": {},
        "error": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "extensionId", "version", "pageId"],
      "properties": {
        "protocol": { "const": "extensions.desktop-rpc.v1" },
        "type": { "const": "host.context" },
        "extensionId": { "type": "string" },
        "version": { "type": "string" },
        "pageId": { "type": "string" },
        "scope": { "type": "string" },
        "scopeId": { "type": "string" },
        "projectId": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "actionId", "pageId"],
      "properties": {
        "protocol": { "const": "extensions.desktop-rpc.v1" },
        "type": { "const": "host.action" },
        "actionId": { "type": "string" },
        "pageId": { "type": "string" }
      }
    }
  ]
}
