    "/api/v1/admin/migration-runs/{runId}/compatibility": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "operationId": "migration0332_get_compatibility",
        "summary": "Read the last stored Gravit source assessment",
        "responses": {
          "200": {
            "description": "Sanitized persisted assessment, not a cutover permit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/GravitCompatibilityReport0332"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Permission settings:manage required"
          },
          "404": {
            "description": "Assessment does not exist"
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-Gravit-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 40
            }
          }
        ],
        "operationId": "migration0332_assess_compatibility",
        "summary": "Inspect Gravit configuration ZIP, journal sanitized report",
        "requestBody": {
          "required": true,
          "content": {
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 67108864
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sanitized persisted assessment, not a cutover permit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/GravitCompatibilityReport0332"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Permission settings:manage required"
          },
          "409": {
            "description": "Source version claim conflict or migration not prepared"
          },
          "413": {
            "description": "ZIP exceeds 64 MiB"
          },
          "415": {
            "description": "Expected application/zip"
          },
          "422": {
            "description": "Invalid or unsafe archive"
          },
          "503": {
            "description": "PostgreSQL report storage unavailable"
          }
        }
      }
    },
