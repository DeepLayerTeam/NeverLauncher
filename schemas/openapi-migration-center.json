  "schemas": {
    "MigrationRun0331": {
      "type": "object",
      "required": [
        "id",
        "projectId",
        "sourceKind",
        "status",
        "step",
        "revision",
        "fence",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "fence": {
          "type": "integer"
        },
        "result": {
          "type": "object"
        },
        "lastError": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "GravitCompatibilityReport0332": {
      "type": "object",
      "required": [
        "format",
        "sourceSha256",
        "sourceEntries",
        "versionEvidence",
        "versionStatus",
        "status",
        "cutoverAllowed",
        "components",
        "findings",
        "summary"
      ],
      "properties": {
        "format": {
          "const": "neverlauncher.gravit-compatibility.v1"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEntries": {
          "type": "integer",
          "minimum": 0
        },
        "claimedVersion": {
          "type": "string"
        },
        "detectedVersion": {
          "type": "string"
        },
        "versionEvidence": {
          "type": "string"
        },
        "versionStatus": {
          "type": "string",
          "enum": [
            "recognized",
            "unverified",
            "unsupported",
            "conflict"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "manual",
            "blocked"
          ]
        },
        "cutoverAllowed": {
          "const": false
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "path",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "component",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "component": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "GravitSourceInventory0333": {
      "type": "object",
      "required": [
        "sourceBytes",
        "sourceEntries",
        "totalBytes",
        "sensitiveEntries",
        "serverReferences",
        "sourceSha256",
        "manifestSha256",
        "format",
        "categories",
        "authProviders",
        "textureProviders",
        "optionalActions",
        "files"
      ],
      "properties": {
        "sourceBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sourceEntries": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sensitiveEntries": {
          "type": "integer",
          "minimum": 0
        },
        "serverReferences": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "neverlauncher.gravit-source-inventory.v1"
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "authProviders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "textureProviders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "optionalActions": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "files": {
          "type": "array",
          "maxItems": 30000,
          "items": {
            "type": "object",
            "required": [
              "path",
              "kind",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "sensitive": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "GravitIdentityReport0334": {
      "type": "object",
      "required": [
        "format",
        "runId",
        "sourceSha256",
        "inventorySha256",
        "entriesSha256",
        "rows",
        "summary",
        "ready"
      ],
      "properties": {
        "format": {
          "const": "neverlauncher.gravit-identity-map.v1"
        },
        "runId": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string"
        },
        "inventorySha256": {
          "type": "string"
        },
        "entriesSha256": {
          "type": "string"
        },
        "ready": {
          "type": "boolean",
          "description": "All identities matched; DOES NOT authorize cutover"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "sourceId",
              "username",
              "uuid",
              "sourcePath",
              "status",
              "reason"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "fileauth",
                  "sql"
                ]
              },
              "sourceId": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "uuid": {
                "type": "string"
              },
              "sourcePath": {
                "type": "string"
              },
              "targetUserId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "matched",
                  "pending_import",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "GravitCredentialResult0335": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "runId",
        "sourceSha256",
        "identitySha256",
        "imported",
        "existingUnchanged",
        "manualReset",
        "complete",
        "dryRun",
        "rows"
      ],
      "properties": {
        "format": {
          "const": "neverlauncher.gravit-credentials.v1"
        },
        "runId": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "identitySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imported": {
          "type": "integer",
          "minimum": 0
        },
        "existingUnchanged": {
          "type": "integer",
          "minimum": 0
        },
        "manualReset": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean",
          "description": "Only credential processing completed; does not authorize cutover"
        },
        "dryRun": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "sourceId",
              "username",
              "uuid",
              "state"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "fileauth",
                  "sql"
                ]
              },
              "sourceId": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "uuid": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "imported",
                  "existing_unchanged",
                  "manual_reset"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
