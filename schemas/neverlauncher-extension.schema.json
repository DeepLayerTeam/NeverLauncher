{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neverlauncher.local/schemas/neverlauncher-extension.schema.json",
  "title": "NeverLauncher Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "publisher", "api", "targets"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string" },
    "homepage": { "type": "string" },
    "repository": { "type": "string" },
    "api": { "type": "string", "minLength": 1, "maxLength": 64 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "entrypoint"],
        "properties": {
          "kind": { "enum": ["backend", "admin", "desktop", "cli"] },
          "entrypoint": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
    },
    "hooks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
