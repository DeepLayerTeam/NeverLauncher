{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launcher.local/schemas/launcher-extension.schema.json",
  "title": "Launcher Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "api",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "api": {
      "type": "string",
      "enum": [
        "1.0",
        "3.7"
      ],
      "description": "Extension API v1. New 0.21+ publications MUST use 1.0; 3.7 is a read/run compatibility alias for immutable 0.20.x artifacts."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entrypoint"
        ],
        "properties": {
          "kind": {
            "enum": [
              "backend",
              "admin",
              "desktop",
              "cli"
            ]
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
      }
    },
    "hooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "pageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "order": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              }
            }
          }
        },
        "dashboardWidgets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "pageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "height": {
                "type": "integer",
                "minimum": 160,
                "maximum": 1200
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "pageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "placement": {
                "type": "string",
                "enum": [
                  "toolbar",
                  "dashboard"
                ]
              }
            }
          }
        }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "pageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "order": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 10000
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "pageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "pageId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "placement": {
                "type": "string",
                "enum": [
                  "toolbar",
                  "page"
                ]
              }
            }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "commands"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "description": {
                "type": "string",
                "maxLength": 240
              },
              "usage": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode"
      ],
      "description": "Signed package policy. Mode isolated fails closed until enforced sandbox host exists. Trusted is unsandboxed.",
      "properties": {
        "version": {
          "const": "1"
        },
        "mode": {
          "enum": [
            "trusted",
            "isolated"
          ]
        },
        "filesystemRead": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(package|shared:[a-z][a-z0-9_-]{0,63})$"
          }
        },
        "filesystemWrite": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(scratch|shared:[a-z][a-z0-9_-]{0,63})$"
          }
        },
        "networkOutbound": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 260
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "maxMemoryBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68719476736
        },
        "maxCpuPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  }
}
