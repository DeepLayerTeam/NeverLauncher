# Пример переменных окружения для локальной разработки

NEVERLAUNCHER_ENV=dev
NEVERLAUNCHER_HTTP_ADDR=0.0.0.0:8080
NEVERLAUNCHER_PUBLIC_URL=http://localhost:8080

NEVERLAUNCHER_DATABASE_DSN=postgres://neverlauncher:neverlauncher@localhost:5432/neverlauncher?sslmode=disable
NEVERLAUNCHER_REPOSITORY_DRIVER=postgres
NEVERLAUNCHER_SQL_DRIVER=pgx
NEVERLAUNCHER_REDIS_ADDR=localhost:6379
NEVERLAUNCHER_REDIS_URL=redis://localhost:6379/0
# Single-node coordinator alternative to Redis. Requires a secure native ext4/XFS/Btrfs directory.
# NEVERLAUNCHER_SINGLE_NODE_COORDINATOR_SQLITE_PATH=/var/lib/neverlauncher/coordinator/state.db
# Включайте только при запуске нескольких реплик управляющего сервиса с PostgreSQL и Redis в режиме высокой доступности.
NEVERLAUNCHER_SERVERBRIDGE_HA_REQUIRED=false
NEVERLAUNCHER_REPLICA_ID=

NEVERLAUNCHER_STORAGE_DRIVER=local
# Optional exact public HTTPS hostname allowlist for imported textures (no wildcards).
NEVERLAUNCHER_TEXTURE_FETCH_HOST_ALLOWLIST=
NEVERLAUNCHER_STORAGE_LOCAL_PATH=./data/storage
NEVERLAUNCHER_BACKUP_ROOT=./data/backups
NEVERLAUNCHER_EXTENSION_ROOT=./data/extensions
# 0.31.10: operator-defined named roots for signed isolated shared:<name> grants.
# Never map backend .env, private keys, database directories or other secrets.
# NEVERLAUNCHER_EXTENSION_SHARED_ROOTS_JSON={"reports":"/srv/neverlauncher-extension-shares/reports"}
NEVERLAUNCHER_EXTENSION_SHARED_ROOTS_JSON=
NEVERLAUNCHER_EXTENSION_BACKUP_RETENTION=10
NEVERLAUNCHER_EXTENSION_HOST_ENABLED=true
NEVERLAUNCHER_EXTENSION_HOST_LISTEN=127.0.0.1:0
NEVERLAUNCHER_EXTENSION_EVENTS_ENABLED=true
NEVERLAUNCHER_EXTENSION_EVENTS_WORKER_INTERVAL_MS=250
NEVERLAUNCHER_EXTENSION_EVENTS_LEASE_SECONDS=30
NEVERLAUNCHER_EXTENSION_EVENTS_HOOK_TIMEOUT_MS=2000
NEVERLAUNCHER_EXTENSION_EVENTS_MAX_ATTEMPTS=8
NEVERLAUNCHER_EXTENSION_EVENTS_BASE_RETRY_MS=1000
NEVERLAUNCHER_EXTENSION_EVENTS_MAX_RETRY_SECONDS=300
NEVERLAUNCHER_EXTENSION_EVENTS_BATCH_SIZE=32

# Доверенные открытые ключи Ed25519 для подписанных данных о фактическом запуске клиента: {"ci-key":"<raw-public-key-hex-or-base64>"}.
NEVERLAUNCHER_RUNTIME_VALIDATION_KEYS_JSON=

NEVERLAUNCHER_AUTH_TOKEN_SECRET=change-me-in-production
# Ротация ключей JWS/JWT для токенов доступа в системе управления сеансами 2.0. Храните
# предыдущие ключи в JSON-наборе, пока не истекут все подписанные ими токены доступа.
NEVERLAUNCHER_AUTH_TOKEN_ISSUER=
NEVERLAUNCHER_AUTH_TOKEN_AUDIENCE=neverlauncher-api
NEVERLAUNCHER_AUTH_TOKEN_ACTIVE_KID=primary
NEVERLAUNCHER_AUTH_TOKEN_KEYS_JSON=

NEVERLAUNCHER_AUTH_TOKEN_TTL_HOURS=12

# Проверяемая сервером политика выпуска NeverGuard 0.14. При отсутствии или некорректном формате производственный запуск
# блокируется. Создавайте её скриптом scripts/release/merge-guard-release-policy.py после окончательного подписания поставщиком.
NEVERLAUNCHER_GUARD_RELEASE_ALLOWLIST_JSON=

# Auth provider routing (0.29.3). Optional. No fallback after an authentication failure.
# Exact email-domain rules; strict=true blocks selecting a different provider for the domain.
# RequireExplicitProvider forces callers to choose providerId for all unmatched identifiers.
# linkingAllowProviders restricts explicit linking, disableLinking disables all linking.
# NEVERLAUNCHER_AUTH_ROUTING_JSON={"version":1,"defaultProvider":"local","requireExplicitProvider":false,"rules":[{"emailDomain":"company.example","providerId":"website","strict":true}],"linkingAllowProviders":["website"]}
# NEVERLAUNCHER_AUTH_ROUTING_FILE=/etc/neverlauncher/auth-routing.json

# Провайдеры SQL-аутентификации (0.11.3). Используйте либо встроенный JSON, либо JSON-файл, но не оба варианта одновременно.
# NEVERLAUNCHER_AUTH_SQL_PROVIDERS_JSON=[{"id":"website","driver":"postgresql","dsnEnv":"WEBSITE_AUTH_DATABASE_DSN","table":"users","columns":{"id":"id","username":"username","email":"email","password":"password_hash","status":"status"},"password":{"algorithm":"bcrypt"},"provisioning":{"mode":"jit","defaultRole":"player"}}]
# NEVERLAUNCHER_AUTH_SQL_PROVIDERS_FILE=/etc/neverlauncher/auth-sql-providers.json
# WEBSITE_AUTH_DATABASE_DSN=postgres://readonly:secret@localhost:5432/site?sslmode=verify-full

# SQL Mapping & Legacy Hash (0.29.4): legacy digest/WordPress PHPass require explicit allowLegacyHashes.
# Gravit digest, sha256 hex: "password":{"algorithm":"digest","digestAlgorithm":"sha256","digestEncoding":"hex","allowLegacyHashes":true}
# Gravit doubleDigest, hash hex string: "password":{"algorithm":"doubleDigest","digestAlgorithm":"md5","doubleDigestHex":true,"digestEncoding":"hex","allowLegacyHashes":true}
# Gravit AdditionalHash WordPress: "password":{"algorithm":"phpass","allowLegacyHashes":true}
# Authentication never updates external SQL passwords. Live SQL column mapping is inspected read-only before activation.

# Провайдеры HTTP-аутентификации (0.11.4). Обязательны HTTPS и подписанные ответы.
# NEVERLAUNCHER_AUTH_HTTP_PROVIDERS_JSON=[{"id":"website-http","baseUrl":"https://auth.example.com/v1","issuer":"website-auth-prod","hostAllowlist":["auth.example.com"],"hmac":{"keyId":"neverlauncher","secretEnv":"WEBSITE_AUTH_HTTP_HMAC_SECRET"},"provisioning":{"mode":"jit","defaultRole":"player"}}]
# NEVERLAUNCHER_AUTH_HTTP_PROVIDERS_FILE=/etc/neverlauncher/auth-http-providers.json
# WEBSITE_AUTH_HTTP_HMAC_SECRET=change-me-at-least-32-random-bytes

# Провайдеры OIDC-аутентификации (0.11.5). Проверки Authorization Code + PKCE S256, issuer/discovery/JWKS должны завершаться отказом при ошибке.
# NEVERLAUNCHER_AUTH_OIDC_PROVIDERS_JSON=[{"id":"company-oidc","issuer":"https://id.example.com/realms/company","clientId":"neverlauncher","clientSecretEnv":"COMPANY_OIDC_CLIENT_SECRET","tokenEndpointAuthMethod":"client_secret_basic","redirectUris":["http://localhost:8080/api/v1/auth/oidc/company-oidc/callback"],"hostAllowlist":["id.example.com"],"provisioning":{"mode":"jit","defaultRole":"player"}}]
# NEVERLAUNCHER_AUTH_OIDC_PROVIDERS_FILE=/etc/neverlauncher/auth-oidc-providers.json
# COMPANY_OIDC_CLIENT_SECRET=change-me

# Федерация удостоверений Microsoft (0.11.6). Microsoft использует специализированный OIDC; учётные данные обновления шифруются на стороне сервера.
# NEVERLAUNCHER_AUTH_MICROSOFT_PROVIDERS_JSON=[{"id":"microsoft","cloud":"global","tenant":"organizations","clientId":"00000000-0000-0000-0000-000000000000","clientSecretEnv":"MICROSOFT_CLIENT_SECRET","redirectUris":["http://localhost:8080/api/v1/auth/oidc/microsoft/callback"],"postLogoutRedirectUris":["http://localhost:5173/"],"provisioning":{"mode":"explicit-only"}}]
# NEVERLAUNCHER_AUTH_MICROSOFT_PROVIDERS_FILE=/etc/neverlauncher/auth-microsoft-providers.json
# MICROSOFT_CLIENT_SECRET=change-me
NEVERLAUNCHER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Ключи доступа Passkeys / WebAuthn и MFA 2.0 (0.11.7). Идентификатор RP должен соответствовать фактическому веб-домену.
NEVERLAUNCHER_WEBAUTHN_RP_ID=localhost
NEVERLAUNCHER_WEBAUTHN_RP_NAME=NeverLauncher
NEVERLAUNCHER_WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8080

# Хранилище, совместимое с S3. Поддерживает локальное хранение и S3.
NEVERLAUNCHER_STORAGE_S3_ENDPOINT=
NEVERLAUNCHER_STORAGE_S3_BUCKET=
NEVERLAUNCHER_STORAGE_S3_REGION=ru-central1
NEVERLAUNCHER_STORAGE_S3_ACCESS_KEY=
NEVERLAUNCHER_STORAGE_S3_SECRET_KEY=
NEVERLAUNCHER_STORAGE_S3_PUBLIC_URL=
NEVERLAUNCHER_STORAGE_S3_PATH_STYLE=true

# Метрики Backend API
NEVERLAUNCHER_METRICS_ENABLED=true

# Проверки постоянного хранилища
NEVERLAUNCHER_PERSISTENT_SESSIONS=true
NEVERLAUNCHER_REQUIRE_PERSISTENT_STORE_IN_PRODUCTION=true
# В production memory repository запрещён:
# NEVERLAUNCHER_ENV=production
# NEVERLAUNCHER_REPOSITORY_DRIVER=postgres
# NEVERLAUNCHER_SQL_DRIVER=pgx
# NEVERLAUNCHER_DATABASE_DSN=postgres://neverlauncher:neverlauncher@postgres:5432/neverlauncher?sslmode=disable
# Защита разрешений NeverExtensions 0.20.7. Обязательна для использования брокера зашифрованных
# секретов. 32 случайных байта в hex или base64. Пример генерации: openssl rand -hex 32
NEVERLAUNCHER_EXTENSION_SECRETS_KEY=
NEVERLAUNCHER_EXTENSION_HTTP_MAX_REQUEST_BYTES=262144
NEVERLAUNCHER_EXTENSION_HTTP_MAX_RESPONSE_BYTES=1048576
NEVERLAUNCHER_EXTENSION_HTTP_TIMEOUT_SECONDS=10

# Yggdrasil / authlib-injector (0.25.6): never reuse manifest Ed25519 keys.
# A persistent unencrypted RSA 2048+ PKCS#8/PKCS#1 PEM file, mode 0600.
NEVERLAUNCHER_YGGDRASIL_RSA_KEY_FILE=
# Optional additional trusted texture hosts or .suffix domains (never use *).
NEVERLAUNCHER_YGGDRASIL_TEXTURE_DOMAINS=

# Official Minecraft 0.25.7 (Microsoft device-code OAuth2 public client).
# Register an Azure/Microsoft identity application with personal Microsoft
# accounts enabled, allow public-client/device-code flows and consent for
# XboxLive.signin + offline_access. Never put a client secret in Desktop.
NEVERLAUNCHER_MINECRAFT_MICROSOFT_CLIENT_ID=
# Official tickets derive AES-GCM keys from NEVERLAUNCHER_AUTH_TOKEN_SECRET.
# In production this MUST be a high-entropy shared secret on all API replicas.

# 0.32.8 deployment topology (auto detects Standard/Network-HA; never silently
# selects an unsupported SQLite-only HTTP repository)
# NEVERLAUNCHER_DEPLOYMENT_MODE=auto
# For Standard + S3 without a local SQLite coordinator, point this at a
# persistent, private, service-owned directory shared by local process restarts.
# NEVERLAUNCHER_DEPLOYMENT_LOCK_PATH=/var/lib/neverlauncher/api.owner.lock

# V05 trusted runtime validation. An operator-controlled JSON array of exact
# required targets; no target matrix => no trusted runtime certification.
# Each entry must include ID, projectId, profileId, channel, version, manifestSha256,
# artifactSha256, resolvedPlanSha256, sourceSha, buildSha, javaSha256,
# javaVersion, os, arch, loader, installAdapterSha256, guardMode,
# guardPolicySha256, serverBridgeSha256, serverPluginVersion and preset.
NEVERLAUNCHER_VALIDATION_REQUIRED_TARGETS_JSON=
