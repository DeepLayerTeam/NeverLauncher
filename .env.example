# Пример переменных окружения для локальной разработки

LAUNCHER_ENV=dev
LAUNCHER_HTTP_ADDR=0.0.0.0:8080
LAUNCHER_PUBLIC_URL=http://localhost:8080

LAUNCHER_DATABASE_DSN=postgres://launcher:launcher@localhost:5432/launcher?sslmode=disable
LAUNCHER_REPOSITORY_DRIVER=postgres
LAUNCHER_SQL_DRIVER=pgx
LAUNCHER_REDIS_ADDR=localhost:6379
LAUNCHER_REDIS_URL=redis://localhost:6379/0
# Single-node coordinator alternative to Redis. Requires a secure native ext4/XFS/Btrfs directory.
# LAUNCHER_SINGLE_NODE_COORDINATOR_SQLITE_PATH=/var/lib/launcher/coordinator/state.db
# Включайте только при запуске нескольких реплик управляющего сервиса с PostgreSQL и Redis в режиме высокой доступности.
LAUNCHER_SERVERBRIDGE_HA_REQUIRED=false
LAUNCHER_REPLICA_ID=

LAUNCHER_STORAGE_DRIVER=local
# Optional exact public HTTPS hostname allowlist for imported textures (no wildcards).
LAUNCHER_TEXTURE_FETCH_HOST_ALLOWLIST=
LAUNCHER_STORAGE_LOCAL_PATH=./data/storage
LAUNCHER_BACKUP_ROOT=./data/backups
LAUNCHER_EXTENSION_ROOT=./data/extensions
# 0.31.10: operator-defined named roots for signed isolated shared:<name> grants.
# Map backend .env, private keys, database directories or other secrets.
# LAUNCHER_EXTENSION_SHARED_ROOTS_JSON={"reports":"/srv/launcher-extension-shares/reports"}
LAUNCHER_EXTENSION_SHARED_ROOTS_JSON=
LAUNCHER_EXTENSION_BACKUP_RETENTION=10
LAUNCHER_EXTENSION_HOST_ENABLED=true
LAUNCHER_EXTENSION_HOST_LISTEN=127.0.0.1:0
LAUNCHER_EXTENSION_EVENTS_ENABLED=true
LAUNCHER_EXTENSION_EVENTS_WORKER_INTERVAL_MS=250
LAUNCHER_EXTENSION_EVENTS_LEASE_SECONDS=30
LAUNCHER_EXTENSION_EVENTS_HOOK_TIMEOUT_MS=2000
LAUNCHER_EXTENSION_EVENTS_MAX_ATTEMPTS=8
LAUNCHER_EXTENSION_EVENTS_BASE_RETRY_MS=1000
LAUNCHER_EXTENSION_EVENTS_MAX_RETRY_SECONDS=300
LAUNCHER_EXTENSION_EVENTS_BATCH_SIZE=32

# Доверенные открытые ключи Ed25519 для подписанных данных о фактическом запуске клиента: {"ci-key":"<raw-public-key-hex-or-base64>"}.
LAUNCHER_RUNTIME_VALIDATION_KEYS_JSON=

LAUNCHER_AUTH_TOKEN_SECRET=change-me-in-production
# Ротация ключей JWS/JWT для токенов доступа в системе управления сеансами 2.0. Храните
# предыдущие ключи в JSON-наборе, пока не истекут все подписанные ими токены доступа.
LAUNCHER_AUTH_TOKEN_ISSUER=
LAUNCHER_AUTH_TOKEN_AUDIENCE=launcher-api
LAUNCHER_AUTH_TOKEN_ACTIVE_KID=primary
LAUNCHER_AUTH_TOKEN_KEYS_JSON=

LAUNCHER_AUTH_TOKEN_TTL_HOURS=12

# Проверяемая сервером политика выпуска Guard 0.14. При отсутствии или некорректном формате производственный запуск
# блокируется. Создавайте её скриптом scripts/release/merge-guard-release-policy.py после окончательного подписания поставщиком.
LAUNCHER_GUARD_RELEASE_ALLOWLIST_JSON=

# Auth provider routing (0.29.3). Optional. No fallback after an authentication failure.
# Exact email-domain rules; strict=true blocks selecting a different provider for the domain.
# RequireExplicitProvider forces callers to choose providerId for all unmatched identifiers.
# linkingAllowProviders restricts explicit linking, disableLinking disables all linking.
# LAUNCHER_AUTH_ROUTING_JSON={"version":1,"defaultProvider":"local","requireExplicitProvider":false,"rules":[{"emailDomain":"company.example","providerId":"website","strict":true}],"linkingAllowProviders":["website"]}
# LAUNCHER_AUTH_ROUTING_FILE=/etc/launcher/auth-routing.json

# Провайдеры SQL-аутентификации (0.11.3). Используйте либо встроенный JSON, либо JSON-файл, но не оба варианта одновременно.
# Live read-only Gravit FileAuthSystem (optional; exact absolute Database.json mount)
# LAUNCHER_AUTH_FILE_PROVIDERS_JSON=[{"id":"gravit-files","databasePath":"/srv/gravit/FileAuthSystem/Database.json","passwordFormat":"phpass","provisioning":{"mode":"explicit-only"}}]
# LAUNCHER_AUTH_FILE_PROVIDERS_FILE=/etc/launcher/auth-file-providers.json
# LAUNCHER_AUTH_SQL_PROVIDERS_JSON=[{"id":"website","driver":"postgresql","dsnEnv":"WEBSITE_AUTH_DATABASE_DSN","table":"users","columns":{"id":"id","username":"username","email":"email","password":"password_hash","status":"status"},"password":{"algorithm":"bcrypt"},"provisioning":{"mode":"jit","defaultRole":"player"}}]
# LAUNCHER_AUTH_SQL_PROVIDERS_FILE=/etc/launcher/auth-sql-providers.json
# WEBSITE_AUTH_DATABASE_DSN=postgres://readonly:secret@localhost:5432/site?sslmode=verify-full

# SQL Mapping & Legacy Hash (0.29.4): legacy digest/WordPress PHPass require explicit allowLegacyHashes.
# Gravit digest, sha256 hex: "password":{"algorithm":"digest","digestAlgorithm":"sha256","digestEncoding":"hex","allowLegacyHashes":true}
# Gravit doubleDigest, hash hex string: "password":{"algorithm":"doubleDigest","digestAlgorithm":"md5","doubleDigestHex":true,"digestEncoding":"hex","allowLegacyHashes":true}
# Gravit AdditionalHash WordPress: "password":{"algorithm":"phpass","allowLegacyHashes":true}
# Authentication updates external SQL passwords. Live SQL column mapping is inspected read-only before activation.

# Провайдеры HTTP-аутентификации (0.11.4). Обязательны HTTPS и подписанные ответы.
# LAUNCHER_AUTH_HTTP_PROVIDERS_JSON=[{"id":"website-http","baseUrl":"https://auth.example.com/v1","issuer":"website-auth-prod","hostAllowlist":["auth.example.com"],"hmac":{"keyId":"launcher","secretEnv":"WEBSITE_AUTH_HTTP_HMAC_SECRET"},"provisioning":{"mode":"jit","defaultRole":"player"}}]
# LAUNCHER_AUTH_HTTP_PROVIDERS_FILE=/etc/launcher/auth-http-providers.json
# WEBSITE_AUTH_HTTP_HMAC_SECRET=change-me-at-least-32-random-bytes

# Провайдеры OIDC-аутентификации (0.11.5). Проверки Authorization Code + PKCE S256, issuer/discovery/JWKS должны завершаться отказом при ошибке.
# LAUNCHER_AUTH_OIDC_PROVIDERS_JSON=[{"id":"company-oidc","issuer":"https://id.example.com/realms/company","clientId":"launcher","clientSecretEnv":"COMPANY_OIDC_CLIENT_SECRET","tokenEndpointAuthMethod":"client_secret_basic","redirectUris":["http://localhost:8080/api/v1/auth/oidc/company-oidc/callback"],"hostAllowlist":["id.example.com"],"provisioning":{"mode":"jit","defaultRole":"player"}}]
# LAUNCHER_AUTH_OIDC_PROVIDERS_FILE=/etc/launcher/auth-oidc-providers.json
# COMPANY_OIDC_CLIENT_SECRET=change-me

# Федерация удостоверений Microsoft (0.11.6). Microsoft использует специализированный OIDC; учётные данные обновления шифруются на стороне сервера.
# LAUNCHER_AUTH_MICROSOFT_PROVIDERS_JSON=[{"id":"microsoft","cloud":"global","tenant":"organizations","clientId":"00000000-0000-0000-0000-000000000000","clientSecretEnv":"MICROSOFT_CLIENT_SECRET","redirectUris":["http://localhost:8080/api/v1/auth/oidc/microsoft/callback"],"postLogoutRedirectUris":["http://localhost:5173/"],"provisioning":{"mode":"explicit-only"}}]
# LAUNCHER_AUTH_MICROSOFT_PROVIDERS_FILE=/etc/launcher/auth-microsoft-providers.json
# MICROSOFT_CLIENT_SECRET=change-me
LAUNCHER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Ключи доступа Passkeys / WebAuthn и MFA 2.0 (0.11.7). Идентификатор RP должен соответствовать фактическому веб-домену.
LAUNCHER_WEBAUTHN_RP_ID=localhost
LAUNCHER_WEBAUTHN_RP_NAME=Launcher
LAUNCHER_WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8080

# Хранилище, совместимое с S3. Поддерживает локальное хранение и S3.
LAUNCHER_STORAGE_S3_ENDPOINT=
LAUNCHER_STORAGE_S3_BUCKET=
LAUNCHER_STORAGE_S3_REGION=ru-central1
LAUNCHER_STORAGE_S3_ACCESS_KEY=
LAUNCHER_STORAGE_S3_SECRET_KEY=
LAUNCHER_STORAGE_S3_PUBLIC_URL=
LAUNCHER_STORAGE_S3_PATH_STYLE=true

# Метрики Backend API
LAUNCHER_METRICS_ENABLED=true

# Проверки постоянного хранилища
LAUNCHER_PERSISTENT_SESSIONS=true
LAUNCHER_REQUIRE_PERSISTENT_STORE_IN_PRODUCTION=true
# В production memory repository запрещён:
# LAUNCHER_ENV=production
# LAUNCHER_REPOSITORY_DRIVER=postgres
# LAUNCHER_SQL_DRIVER=pgx
# LAUNCHER_DATABASE_DSN=postgres://launcher:launcher@postgres:5432/launcher?sslmode=disable
# Защита разрешений Extensions 0.20.7. Обязательна для использования брокера зашифрованных
# секретов. 32 случайных байта в hex или base64. Пример генерации: openssl rand -hex 32
LAUNCHER_EXTENSION_SECRETS_KEY=
LAUNCHER_EXTENSION_HTTP_MAX_REQUEST_BYTES=262144
LAUNCHER_EXTENSION_HTTP_MAX_RESPONSE_BYTES=1048576
LAUNCHER_EXTENSION_HTTP_TIMEOUT_SECONDS=10

# Yggdrasil / authlib-injector (0.25.6): reuse manifest Ed25519 keys.
# A persistent unencrypted RSA 2048+ PKCS#8/PKCS#1 PEM file, mode 0600.
LAUNCHER_YGGDRASIL_RSA_KEY_FILE=
# Optional additional trusted texture hosts or .suffix domains (use *).
LAUNCHER_YGGDRASIL_TEXTURE_DOMAINS=

# Official Minecraft 0.25.7 (Microsoft device-code OAuth2 public client).
# Register an Azure/Microsoft identity application with personal Microsoft
# accounts enabled, allow public-client/device-code flows and consent for
# XboxLive.signin + offline_access. Put a client secret in Desktop.
LAUNCHER_MINECRAFT_MICROSOFT_CLIENT_ID=
# Official tickets derive AES-GCM keys from LAUNCHER_AUTH_TOKEN_SECRET.
# In production this MUST be a high-entropy shared secret on all API replicas.

# 0.32.8 deployment topology (auto detects Standard/Network-HA; silently
# selects an unsupported SQLite-only HTTP repository)
# LAUNCHER_DEPLOYMENT_MODE=auto
# For Standard + S3 without a local SQLite coordinator, point this at a
# persistent, private, service-owned directory shared by local process restarts.
# LAUNCHER_DEPLOYMENT_LOCK_PATH=/var/lib/launcher/api.owner.lock

# V05 trusted runtime validation. An operator-controlled JSON array of exact
# required targets; no target matrix => no trusted runtime certification.
# Each entry must include ID, projectId, profileId, channel, version, manifestSha256,
# artifactSha256, resolvedPlanSha256, sourceSha, buildSha, javaSha256,
# javaVersion, os, arch, loader, installAdapterSha256, guardMode,
# guardPolicySha256, serverBridgeSha256, serverPluginVersion and preset.
LAUNCHER_VALIDATION_REQUIRED_TARGETS_JSON=

# 0.41.3: absolute path to 0600 operator-approved ServerBridge → RemoteControl targets JSON.
LAUNCHER_SERVER_BRIDGE_HOST_TARGETS_FILE=
